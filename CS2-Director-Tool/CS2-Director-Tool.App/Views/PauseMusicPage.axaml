<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CS2_Director_Tool.App.ViewModels"
             x:Class="CS2_Director_Tool.App.Views.PauseMusicPage"
             x:DataType="vm:PauseMusicViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="暂停音乐" Classes="page-title" />
            <TextBlock Text="游戏暂停时自动播放背景音乐，暂停结束自动停止" Classes="page-subtitle" />

            <Border Classes="card">
                <StackPanel>
                    <CheckBox Content="启用暂停音乐" IsChecked="{Binding IsEnabled}"
                              Classes="toggle" />
                    <TextBlock Text="{Binding Status}" Classes="label-text"
                               Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding IsEnabled}">
                    <TextBlock Grid.Column="0" Text="音乐源名:" Classes="label-text"
                               Margin="0,0,12,0" Width="88" />
                    <TextBox Grid.Column="1" Text="{Binding MusicSourceName}"
                             Classes="input" />
                </Grid>
            </Border>

            <!-- 诊断日志控制台 -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="日志" Classes="section-title" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="清空" Command="{Binding ClearLogCommand}"
                                Padding="14,6" Classes="btn" />
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding LogText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="260"
                             Padding="10,8"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource SurfaceBorderBrush}"
                             FontFamily="Consolas, Menlo, monospace"
                             FontSize="12"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Classes="input" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
