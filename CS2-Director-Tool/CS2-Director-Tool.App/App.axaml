<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CS2_Director_Tool.App.App"
             xmlns:local="using:CS2_Director_Tool.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CS2-Director-Tool.App/Themes/LycorisTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CS2-Director-Tool.App/Themes/CommonStyles.axaml" />
        <StyleInclude Source="avares://CS2-Director-Tool.App/Themes/ButtonStyles.axaml" />
        <StyleInclude Source="avares://CS2-Director-Tool.App/Themes/TextBoxStyles.axaml" />
        <StyleInclude Source="avares://CS2-Director-Tool.App/Themes/SidebarStyles.axaml" />
    </Application.Styles>
</Application>
